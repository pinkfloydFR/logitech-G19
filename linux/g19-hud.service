[Unit]
Description=G19 HUD (tableau de bord sur l'écran LCD du Logitech G19)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PREFIX@
Environment=G15_BACKEND=g19
Environment=G19_UI=native
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Surcharges : G19_BRIGHTNESS=60, G19_UI=retro, G19_THEME=green ...
EnvironmentFile=-/etc/default/g19-hud
ExecStart=/usr/bin/python3 @PREFIX@/g15_dashboard.py
Restart=always
RestartSec=3
# Arrêt PROPRE obligatoire : couper une trame USB en plein envoi fige l'écran du G19.
KillSignal=SIGTERM
TimeoutStopSec=10
SendSIGKILL=yes
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
